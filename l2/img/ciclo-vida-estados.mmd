flowchart LR
    P(["1. Pendiente<br/>(Backlog)"]) --> R["2. En Revisión<br/>(Comité CCB)"]
    R -- "Desestimado" --> X(["Rechazado"])
    R -- "Aprobado" --> D["3. En Desarrollo<br/>(Construcción)"]
    D --> Q["4. En Pruebas<br/>(Verificación QA)"]
    Q -- "Observaciones" --> D
    Q -- "Conforme" --> C(["5. Cerrado<br/>(Línea Base)"])

    classDef proc fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px;
    classDef term fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.5px;
    classDef reject fill:#ffebee,stroke:#c62828,stroke-width:1.5px;

    class R,D,Q proc;
    class P,C term;
    class X reject;
