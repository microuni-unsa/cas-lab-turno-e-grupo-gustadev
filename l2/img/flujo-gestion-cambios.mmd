flowchart LR
    subgraph Fase1["Fase 1: Registro y Evaluación Colegiada"]
        direction LR
        A(["RFC: Solicitud<br/>de Cambio"]) --> B["1. Registro y<br/>Priorización"]
        B --> C["2. Análisis de<br/>Impacto y Costo"]
        C --> D{"3. Dictamen<br/>del CCB"}
        D -- "Rechazado" --> R(["Solicitud<br/>Desestimada"])
    end

    subgraph Fase2["Fase 2: Construcción, Aseguramiento y Cierre"]
        direction LR
        E["4. Planificación<br/>y Asignación"] --> F["5. Implementación<br/>en Rama Aislada"]
        F --> G["6. Pruebas QA<br/>y Regresión"]
        G -- "Observaciones" --> F
        G -- "Conforme" --> H["7. Integración<br/>en Línea Base"]
        H --> S(["Cambio Cerrado<br/>y Desplegado"])
    end

    D -- "Aprobado" --> E

    classDef proc fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px;
    classDef decision fill:#fff8e1,stroke:#f57f17,stroke-width:1.5px;
    classDef term fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.5px;
    classDef reject fill:#ffebee,stroke:#c62828,stroke-width:1.5px;

    class B,C,E,F,G,H proc;
    class D decision;
    class A,S term;
    class R reject;
