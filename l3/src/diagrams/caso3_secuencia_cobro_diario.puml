@startuml
autonumber
actor "Scheduler Diario" as S
participant "GestorProcesamiento\n<<Singleton>>" as G
participant "Pedido Compuesto" as PC
participant "Cuenta 1" as C1
participant "Cuenta 2" as C2
participant "Distribucion" as D

S -> G : ejecutarCobroDiario()
G -> PC : obtenerCuentasAsociadas()
PC --> G : [Cuenta 1, Cuenta 2]

G -> C1 : verificarSaldo(Monto 1)
alt Fondos Suficientes en todas las cuentas
    C1 --> G : OK
    G -> C2 : verificarSaldo(Monto 2)
    C2 --> G : OK
    G -> C1 : debitar(Monto 1)
    G -> C2 : debitar(Monto 2)
    G -> PC : marcarEstado(COBRADO)
    G -> G : ordenarDistribucion(PC)
    G -> PC : marcarEstado(EN_DISTRIBUCION)
    G -> D : emitirOrdenDespacho()
else Fondos Insuficientes en alguna cuenta
    C2 --> G : Error Saldo Insuficiente
    G -> PC : marcarEstado(RECHAZADO)
    note right: Rechazo Atómico Integral
end
@enduml
